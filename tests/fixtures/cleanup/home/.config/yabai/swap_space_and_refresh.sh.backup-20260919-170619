#!/usr/bin/env bash
set -euo pipefail

target_space="${1:-}"

case "$target_space" in
  [1-9]|10) ;;
  *) exit 64 ;;
esac

YABAI_BIN="${YABAI_BIN:-/opt/homebrew/bin/yabai}"
SKETCHYBAR_BIN="${SKETCHYBAR_BIN:-/opt/homebrew/bin/sketchybar}"

current_space="$("$YABAI_BIN" -m query --spaces --space | /opt/homebrew/bin/jq -r '.index')"
[ "$current_space" != "$target_space" ] || exit 0

"$YABAI_BIN" -m space --swap "$target_space"

# Window icons + highlight follow the new indices
"$SKETCHYBAR_BIN" --trigger space_windows_change --trigger space_change >/dev/null 2>&1 || true
