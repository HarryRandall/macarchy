"$HOME/.config/macarchy/Macarchy.app/Contents/MacOS/macarchy" startup yabai

# >>> macarchy:keep yours
# Load the scripting addition (optional; needs SIP partly disabled).
sudo yabai --load-sa
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"

