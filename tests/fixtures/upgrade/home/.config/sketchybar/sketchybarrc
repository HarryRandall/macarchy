#!/bin/bash
# Generated by Macarchy. The bar comes from the Menu Bar page and the active theme.
#
# Add your own commands inside the region below; it is kept when this
# file is regenerated. Changes anywhere else are reported and replaced.
# >>> macarchy:keep yours
source "$CONFIG_DIR/colors.sh"

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

sketchybar --remove '/.*/' >/dev/null 2>&1 || true

# color is 0x01000000, not 0x00000000, on purpose: a fully transparent window
# gets treated as pass-through by the compositor, which leaves stale pixels
# where items relayout. Bar, font and defaults go out as one invocation.
sketchybar --bar height=37        \
                 blur_radius=0    \
                 display=all      \
                 position=top     \
                 sticky=on        \
                 padding_left=10  \
                 padding_right=10 \
                 color=0x01000000 \
           --load-font "$HOME/Library/Fonts/sketchybar-app-font.ttf" \
           --default icon.font="SF Pro:Semibold:15.0"   \
                     icon.color=$TEXT_COLOR             \
                     label.font="SF Pro:Semibold:12.0"  \
                     label.color=$TEXT_COLOR            \
                     background.color=0x00000000        \
                     background.border_color=0x33ffffff \
                     background.border_width=1          \
                     background.drawing=on              \
                     background.corner_radius=5         \
                     background.height=24               \
                     padding_left=5                     \
                     padding_right=5                    \
                     label.y_offset=1                   \
                     label.padding_left=4               \
                     label.padding_right=10             \
                     icon.padding_left=10               \
                     icon.padding_right=4

source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/calendar.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/system_metrics.sh"

# Macarchy triggers this after applying a theme; recolour in place.
sketchybar --add event macarchy_theme_changed \
           --add item theme_listener left \
           --set theme_listener drawing=off width=0 script="$CONFIG_DIR/recolor.sh" \
           --subscribe theme_listener macarchy_theme_changed
# <<< macarchy:keep

"$HOME/.config/macarchy/Macarchy.app/Contents/MacOS/macarchy" startup sketchybar

sketchybar --update
