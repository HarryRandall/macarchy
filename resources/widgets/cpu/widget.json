{
  "schema": 1,
  "id": "cpu",
  "name": "CPU",
  "version": "1.0.0",
  "author": "Macarchy",
  "description": "Load and temperature, with per-core use and the busiest apps in its dropdown.",
  "icon": "􀧓",
  "source": "cpu",
  "label": "{load}\n{temperature}",
  "settings": {
    "layout": { "type": "choice", "label": "Layout", "options": ["stacked", "single", "graph"], "default": "stacked" },
    "fixedWidth": { "type": "toggle", "label": "Fixed width", "default": true, "hint": "Sized to the widest sample, so neighbours never shift" },
    "warnLoad": { "type": "number", "label": "Amber above", "default": 75, "min": 1, "max": 100, "unit": "%" },
    "warnTemperature": { "type": "number", "label": "Amber above", "default": 80, "min": 30, "max": 110, "unit": "°" }
  },
  "style": { "box": "outline", "size": 12 },
  "update": { "every": "2s", "events": ["system_woke"] },
  "click": {
    "dropdown": [
      { "type": "heading", "label": "CPU", "value": "{load.short}" },
      { "type": "text", "label": "{chip} · {cores.performance} performance, {cores.efficiency} efficiency" },
      { "type": "graph", "value": "{history}" },
      { "type": "divider" },
      { "type": "heading", "label": "Cores" },
      { "type": "cores", "value": "{cores}" },
      { "type": "divider" },
      { "type": "reading", "label": "Temperature", "value": "{temperature}" },
      { "type": "divider" },
      { "type": "heading", "label": "Using the most CPU" },
      { "type": "apps", "value": "{top}" },
      { "type": "divider" },
      { "type": "action", "label": "Open Activity Monitor…", "open": "Activity Monitor" }
    ]
  },
  "samples": { "widest": "100.0%\n99.9°", "unavailable": "--\n--" }
}
