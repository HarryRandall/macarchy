{
  "schema": 1,
  "id": "cpu",
  "name": "CPU",
  "version": "1.0.0",
  "author": "Macarchy",
  "description": "Load and temperature over the last minute, per-core use and the busiest apps in its dropdown.",
  "icon": "􀧓",
  "source": "cpu",
  "label": "{load}\n{temperature}",
  "settings": {
    "warnLoad": {
      "type": "number",
      "label": "Amber above",
      "default": 75,
      "min": 1,
      "max": 100,
      "unit": "%",
      "hint": "Load turns amber above this, and red above 95%"
    },
    "warnTemperature": {
      "type": "number",
      "label": "Hot above",
      "default": 80,
      "min": 30,
      "max": 110,
      "unit": "°",
      "hint": "Temperature turns amber above this, and red above 95°"
    }
  },
  "style": {
    "box": "outline",
    "size": 12,
    "lines": 2
  },
  "update": {
    "every": "2s",
    "events": [
      "system_woke"
    ]
  },
  "click": {
    "dropdown": [
      {
        "type": "heading",
        "label": "CPU",
        "value": "{chip}"
      },
      {
        "type": "graph",
        "label": "Load",
        "value": "{history}",
        "current": "{load.short}"
      },
      {
        "type": "graph",
        "label": "Temp",
        "value": "{temperatures}",
        "current": "{temperature}",
        "colour": "temperature",
        "unit": "°"
      },
      {
        "type": "divider"
      },
      {
        "type": "cores",
        "label": "Cores",
        "value": "{cores}"
      },
      {
        "type": "divider"
      },
      {
        "type": "heading",
        "label": "Using the most CPU"
      },
      {
        "type": "apps",
        "value": "{top}"
      },
      {
        "type": "divider"
      },
      {
        "type": "action",
        "label": "Open Activity Monitor…",
        "open": "Activity Monitor"
      }
    ]
  },
  "samples": {
    "widest": "100.0%\n99.9°",
    "unavailable": "--\n--"
  }
}
