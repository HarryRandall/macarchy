{
  "schema": 1,
  "id": "memory",
  "name": "Memory",
  "version": "1.0.0",
  "author": "Macarchy",
  "description": "Memory in use, with what is using it and the busiest apps.",
  "icon": "􀫦",
  "source": "memory",
  "label": "{percent}\n{used}",
  "style": {
    "box": "outline",
    "size": 12,
    "lines": 2
  },
  "update": {
    "every": "2s",
    "events": [
      "system_woke"
    ]
  },
  "click": {
    "dropdown": [
      {
        "type": "heading",
        "label": "Memory",
        "value": "{percent}"
      },
      {
        "type": "text",
        "label": "{used} of {total} in use · Pressure {pressure}"
      },
      {
        "type": "graph",
        "label": "Last minute",
        "value": "{history}"
      },
      {
        "type": "divider"
      },
      {
        "type": "reading",
        "label": "App memory",
        "value": "{app}"
      },
      {
        "type": "reading",
        "label": "Wired",
        "value": "{wired}"
      },
      {
        "type": "reading",
        "label": "Compressed",
        "value": "{compressed}"
      },
      {
        "type": "reading",
        "label": "Cached files",
        "value": "{cached}"
      },
      {
        "type": "reading",
        "label": "Swap used",
        "value": "{swap}"
      },
      {
        "type": "divider"
      },
      {
        "type": "heading",
        "label": "Using the most memory"
      },
      {
        "type": "apps",
        "value": "{top}"
      },
      {
        "type": "divider"
      },
      {
        "type": "action",
        "label": "Open Activity Monitor…",
        "open": "Activity Monitor"
      }
    ]
  },
  "samples": {
    "widest": "100.0%\n99.9G",
    "unavailable": "--\n--"
  }
}
