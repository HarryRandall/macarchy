{
  "schema": 1,
  "id": "gpu",
  "name": "GPU",
  "version": "1.0.0",
  "author": "Macarchy",
  "description": "Graphics load and temperature, with a graph of recent load.",
  "icon": "􀎲",
  "source": "gpu",
  "label": "{load}\n{temperature}",
  "settings": {
    "warnLoad": {
      "type": "number",
      "label": "Amber above",
      "default": 80,
      "min": 1,
      "max": 100,
      "unit": "%",
      "hint": "Load turns amber above this, and red above 95%"
    },
    "warnTemperature": {
      "type": "number",
      "label": "Hot above",
      "default": 85,
      "min": 30,
      "max": 110,
      "unit": "°",
      "hint": "Temperature turns amber above this, and red above 95°"
    }
  },
  "style": {
    "box": "outline",
    "size": 12,
    "lines": 2
  },
  "update": {
    "every": "2s",
    "events": [
      "system_woke"
    ]
  },
  "click": {
    "dropdown": [
      {
        "type": "heading",
        "label": "GPU",
        "value": "{load.short}"
      },
      {
        "type": "graph",
        "label": "Last minute",
        "value": "{history}"
      },
      {
        "type": "divider"
      },
      {
        "type": "reading",
        "label": "Load",
        "value": "{load}"
      },
      {
        "type": "reading",
        "label": "Temperature",
        "value": "{temperature}"
      },
      {
        "type": "divider"
      },
      {
        "type": "action",
        "label": "Open Activity Monitor…",
        "open": "Activity Monitor"
      }
    ]
  },
  "samples": {
    "widest": "100.0%\n99.9°",
    "unavailable": "--\n--"
  }
}
