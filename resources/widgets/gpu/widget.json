{
  "schema": 1,
  "id": "gpu",
  "name": "GPU",
  "version": "1.0.0",
  "author": "Macarchy",
  "description": "Graphics load and temperature, the memory it holds and the apps using it.",
  "icon": "􀎲",
  "source": "gpu",
  "label": "{load}\n{temperature}",
  "settings": {
    "warnLoad": {
      "type": "number",
      "label": "Amber above",
      "default": 80,
      "min": 1,
      "max": 100,
      "unit": "%",
      "hint": "Load turns amber above this, and red above 95%"
    },
    "warnTemperature": {
      "type": "number",
      "label": "Hot above",
      "default": 85,
      "min": 30,
      "max": 110,
      "unit": "°",
      "hint": "Temperature turns amber above this, and red above 95°"
    }
  },
  "style": {
    "box": "outline",
    "size": 12,
    "lines": 2
  },
  "update": {
    "every": "2s",
    "events": [
      "system_woke"
    ]
  },
  "click": {
    "dropdown": [
      {
        "type": "heading",
        "label": "GPU",
        "value": "{cores}"
      },
      {
        "type": "graph",
        "label": "Load",
        "value": "{history}",
        "current": "{load.short}"
      },
      {
        "type": "graph",
        "label": "Temp",
        "value": "{temperatures}",
        "current": "{temperature}",
        "colour": "temperature",
        "unit": "°"
      },
      {
        "type": "divider"
      },
      {
        "type": "reading",
        "label": "Graphics memory",
        "value": "{memory.summary}"
      },
      {
        "type": "map",
        "value": "In use:{memory.gb}",
        "max": "{memory.limit.gb}",
        "colour": "#bf5af2",
        "unit": "GB",
        "cells": 64
      },
      {
        "type": "divider"
      },
      {
        "type": "heading",
        "label": "Using the GPU",
        "when": "{top}"
      },
      {
        "type": "apps",
        "value": "{top}",
        "when": "{top}"
      },
      {
        "type": "divider",
        "when": "{top}"
      },
      {
        "type": "action",
        "label": "Open Activity Monitor…",
        "open": "Activity Monitor"
      }
    ]
  },
  "samples": {
    "widest": "100.0%\n99.9°",
    "unavailable": "--\n--"
  }
}
