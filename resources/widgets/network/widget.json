{
  "schema": 1,
  "id": "network",
  "name": "Network",
  "version": "1.0.0",
  "author": "Macarchy",
  "description": "Upload over download, with a graph of recent downloads and your address.",
  "icon": "􀤆",
  "source": "network",
  "label": "{up}\n{down}",
  "style": {
    "box": "outline",
    "size": 12,
    "lines": 2
  },
  "update": {
    "every": "2s",
    "events": [
      "system_woke"
    ]
  },
  "click": {
    "dropdown": [
      {
        "type": "heading",
        "label": "Network",
        "value": "{interface}"
      },
      {
        "type": "graph",
        "label": "Download, last minute (KB/s)",
        "value": "{history}"
      },
      {
        "type": "divider"
      },
      {
        "type": "reading",
        "label": "Download",
        "value": "{down}"
      },
      {
        "type": "reading",
        "label": "Upload",
        "value": "{up}"
      },
      {
        "type": "divider"
      },
      {
        "type": "reading",
        "label": "Address",
        "value": "{address}"
      },
      {
        "type": "reading",
        "label": "Received since start",
        "value": "{received}"
      },
      {
        "type": "reading",
        "label": "Sent since start",
        "value": "{sent}"
      },
      {
        "type": "divider"
      },
      {
        "type": "action",
        "label": "Network Settings…",
        "open": "x-apple.systempreferences:com.apple.Network-Settings.extension"
      }
    ]
  },
  "samples": {
    "widest": "99.9MB/s\n99.9MB/s",
    "unavailable": "--\n--"
  }
}
