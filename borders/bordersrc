#!/usr/bin/env bash
set -euo pipefail

theme_file="${XDG_CONFIG_HOME:-$HOME/.config}/macarchy/generated/borders.conf"

active_color="0xfff2fcff"
inactive_color="0x00000000"
width="6.0"
blacklist="iPhone Mirroring"

# This file is generated by theme-switch and contains validated values only.
if [[ -r "$theme_file" ]]; then
    # shellcheck source=/dev/null
    source "$theme_file"
fi

exec borders \
    style=round \
    hidpi=on \
    ax_focus=on \
    active_color="$active_color" \
    inactive_color="$inactive_color" \
    width="$width" \
    blacklist="$blacklist"
