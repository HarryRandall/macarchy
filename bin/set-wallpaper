#!/usr/bin/env bash
set -u

if [[ $# -ne 1 ]]; then
    printf 'usage: %s <image-path>\n' "$0" >&2
    exit 1
fi

image_input="$1"
image_dir="$(cd "$(dirname "$image_input")" 2>/dev/null && pwd -P)" || {
    printf 'error: image directory was not found\n' >&2
    exit 1
}
image="$image_dir/$(basename "$image_input")"

[[ -f "$image" ]] || {
    printf 'error: image was not found: %s\n' "$image" >&2
    exit 1
}

set_with_desktoppr() {
    local desktoppr_bin
    desktoppr_bin="$(command -v desktoppr 2>/dev/null || true)"
    [[ -n "$desktoppr_bin" ]] || return 1
    "$desktoppr_bin" all "$image" >/dev/null 2>&1
}

set_with_system_events() {
    /usr/bin/osascript - "$image" >/dev/null 2>&1 <<'APPLESCRIPT'
on run argv
  set imagePath to POSIX file (item 1 of argv)
  tell application "System Events"
    repeat with desktopItem in desktops
      set picture of desktopItem to imagePath
    end repeat
  end tell
end run
APPLESCRIPT
}

set_with_finder() {
    /usr/bin/osascript - "$image" >/dev/null 2>&1 <<'APPLESCRIPT'
on run argv
  tell application "Finder" to set desktop picture to POSIX file (item 1 of argv)
end run
APPLESCRIPT
}

# desktoppr uses the public workspace API. AppleScript remains as a fallback
# for systems where desktoppr is not installed or lacks Automation access.
if set_with_desktoppr || set_with_system_events || set_with_finder; then
    exit 0
fi

printf 'error: the wallpaper could not be changed\n' >&2
exit 1
