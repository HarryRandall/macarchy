#!/usr/bin/env bash
set -u

MACARCHY_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_lib="$(cd "$MACARCHY_BIN_DIR/.." && pwd)/lib/macarchy"
installed_lib="${XDG_DATA_HOME:-$HOME/.local/share}/macarchy/lib"
MACARCHY_LIB_DIR="${MACARCHY_LIB_DIR:-}"

if [[ -z "$MACARCHY_LIB_DIR" && -d "$repo_lib" ]]; then
    MACARCHY_LIB_DIR="$repo_lib"
elif [[ -z "$MACARCHY_LIB_DIR" && -d "$installed_lib" ]]; then
    MACARCHY_LIB_DIR="$installed_lib"
fi

if [[ -z "$MACARCHY_LIB_DIR" || ! -d "$MACARCHY_LIB_DIR" ]]; then
    printf 'error: Macarchy libraries were not found\n' >&2
    exit 1
fi

# shellcheck source=/dev/null
source "$MACARCHY_LIB_DIR/common.sh"
source "$MACARCHY_LIB_DIR/theme.sh"
source "$MACARCHY_LIB_DIR/colours.sh"
source "$MACARCHY_LIB_DIR/apply/appearance.sh"
source "$MACARCHY_LIB_DIR/apply/ghostty.sh"
source "$MACARCHY_LIB_DIR/apply/tools.sh"
source "$MACARCHY_LIB_DIR/apply/desktop.sh"

usage() {
    cat <<'EOF'
Usage:
  theme-switch --list
  theme-switch <theme-name>
  theme-switch next|prev
  theme-switch --background <theme-name> <relative-image-path>
EOF
}

apply_theme() {
    local name="$1"
    local background failures=0

    macarchy_theme_load "$name" || return 1
    background="$(macarchy_theme_selected_background)"

    macarchy_info "Applying theme: $name"
    macarchy_apply_appearance || failures=$((failures + 1))
    macarchy_apply_wallpaper "$background" || failures=$((failures + 1))
    macarchy_apply_ghostty || failures=$((failures + 1))
    macarchy_apply_neovim || failures=$((failures + 1))
    macarchy_apply_borders || failures=$((failures + 1))
    macarchy_apply_btop || failures=$((failures + 1))
    macarchy_apply_sketchybar || failures=$((failures + 1))
    macarchy_apply_shell || failures=$((failures + 1))

    if (( failures > 0 )); then
        macarchy_error "theme '$name' was only partly applied"
        return 1
    fi

    if ! printf '%s\n' "$name" | macarchy_write_generated "$MACARCHY_THEME_STATE"; then
        macarchy_error "active theme state could not be written"
        return 1
    fi
    macarchy_info "Theme '$name' applied."
}

case "${1:-}" in
    --list)
        macarchy_theme_list
        ;;
    --background)
        [[ $# -eq 3 ]] || { usage >&2; exit 1; }
        macarchy_theme_load "$2" || exit 1
        macarchy_theme_save_background "$3" || exit 1
        if [[ "$(macarchy_theme_current)" == "$2" ]]; then
            macarchy_apply_wallpaper "$3"
        else
            macarchy_info "Saved background for theme '$2'."
        fi
        ;;
    next|prev)
        target="$(macarchy_theme_cycle "$1")" || exit 1
        apply_theme "$target"
        ;;
    '')
        usage >&2
        exit 1
        ;;
    -*)
        usage >&2
        exit 1
        ;;
    *)
        [[ $# -eq 1 ]] || { usage >&2; exit 1; }
        apply_theme "$1"
        ;;
esac
